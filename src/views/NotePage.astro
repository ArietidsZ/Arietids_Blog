---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/ui/Icon.astro';
import Typeset from '~/components/ui/Typeset.astro';
import { formatDate, htmlLang, localePath, t, type Locale } from '~/i18n';
import { getNotes, noteSlug } from '~/lib/content';
import { blogPath, categoryLabel, categoryPath } from '~/lib/blog';
import { script } from '~/lib/typeset';
import { site } from '~/config/site';

interface Props {
  lang: Locale;
  note: CollectionEntry<'notes'>;
  /** Locales in which this note exists, for hreflang and the language switch. */
  alternates: Locale[];
}
const { lang, note, alternates } = Astro.props;
const _ = t(lang);
const { Content, headings } = await render(note);
// The footnotes heading is GFM's, not the author's: it stays out of the table of contents.
const outline = headings.filter((heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label');
const other = alternates.find((l) => l !== lang);
const notes = await getNotes(lang);
const position = notes.findIndex((n) => n.id === note.id);
const older = position >= 0 ? notes[position + 1] : undefined;
const newer = position > 0 ? notes[position - 1] : undefined;
const slug = noteSlug(note);
const url = new URL(localePath(lang, blogPath(slug)), Astro.site).href;
const author = site.author;
const title = note.data.title;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: title, description: note.data.description,
  datePublished: note.data.date.toISOString(),
  dateModified: (note.data.updated ?? note.data.date).toISOString(),
  url, mainEntityOfPage: url, inLanguage: htmlLang[lang],
  articleSection: categoryLabel(note.data.category, lang),
  ...(author ? { author: { '@type': 'Person', name: author, url: site.homepage } } : {}),
  ...(note.data.tags.length ? { keywords: note.data.tags } : {}),
};
// Reading time: Han characters at about 400 a minute, words at about 230; code and math excluded.
const plain = (note.body ?? '')
  .replace(/```[\s\S]*?```/g, '')
  .replace(/\$\$[\s\S]*?\$\$/g, '')
  .replace(/`[^`\n]*`/g, '')
  .replace(/<[^>]+>/g, '');
const han = (plain.match(/\p{Script=Han}/gu) ?? []).length;
const words = (plain.replace(/\p{Script=Han}/gu, ' ').match(/[A-Za-z0-9]+(?:['’-][A-Za-z0-9]+)*/g) ?? []).length;
const minutes = Math.max(1, Math.round(han / 400 + words / 230));
const neighbour = (n: CollectionEntry<'notes'>, rel: 'prev' | 'next') => ({
  slug: noteSlug(n),
  href: localePath(lang, blogPath(noteSlug(n))),
  rel,
  label: rel === 'prev' ? _('notes.older') : _('notes.newer'),
  title: n.data.title,
});
const adjacent = [older && neighbour(older, 'prev'), newer && neighbour(newer, 'next')].filter(Boolean) as ReturnType<typeof neighbour>[];
---

<Base lang={lang} title={title} description={note.data.description} type="article" alternates={alternates}>
  <Fragment slot="head">
    <meta property="article:published_time" content={note.data.date.toISOString()} />
    <meta property="article:modified_time" content={(note.data.updated ?? note.data.date).toISOString()} />
    <meta property="article:section" content={categoryLabel(note.data.category, lang)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </Fragment>
  <article class="note" data-visibility={note.data.visibility}>
    <div class:list={['layout container', { 'has-outline': outline.length > 0 }]}>
      <header class="head">
        <a class="back label" href={localePath(lang, '/')}><Icon name="arrow-left" size={13} /> {_('notes.back')}</a>
        <p class="kicker">
          <a class="cat label" href={localePath(lang, categoryPath(note.data.category))}>{categoryLabel(note.data.category, lang)}</a>
          <span class="sep" aria-hidden="true"></span>
          <time datetime={note.data.date.toISOString().slice(0, 10)}>{formatDate(note.data.date, lang)}</time>
          <span class="sep" aria-hidden="true"></span>
          <span>{_('notes.minutes', { n: minutes })}</span>
        </p>
        <h1 data-script={script(title)} style={`view-transition-name:t-${slug}`}>
          <Typeset text={title} />
        </h1>
        <p class="lede">{note.data.description}</p>
        {
          (note.data.tags.length > 0 || note.data.updated || other) && (
            <div class="byline">
              {note.data.tags.length > 0 && (
                <ul class="tags" role="list" aria-label={_('notes.tags')}>
                  {note.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
              {note.data.updated && (
                <p class="updated">
                  {_('notes.updated')} <time datetime={note.data.updated.toISOString().slice(0, 10)}>{formatDate(note.data.updated, lang)}</time>
                </p>
              )}
              {other && (
                <a class="other btn btn-ghost btn-sm" href={localePath(other, blogPath(slug))} hreflang={htmlLang[other]}>
                  {_('notes.otherLang')}
                  <Icon name="arrow-right" size={13} />
                </a>
              )}
            </div>
          )
        }
      </header>

      {
        outline.length > 0 && (
          <details class="outline" open>
            <summary>
              <span class="label">{_('notes.contents')}</span>
              <Icon name="chevron" size={14} />
            </summary>
            <nav aria-label={_('notes.contents')} data-toc>
              <ol role="list">
                {outline.map((heading) => (
                  <li class:list={[heading.depth === 3 && 'subheading']}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
              <span class="toc-mark" aria-hidden="true"></span>
            </nav>
          </details>
        )
      }

      <div class="prose" data-prose>
        <Content />
      </div>

      {
        adjacent.length > 0 && (
          <nav class="adjacent" aria-label={_('notes.articles')}>
            {adjacent.map((a) => (
              <a href={a.href} rel={a.rel} class:list={['cell', a.rel]}>
                <span class="label">
                  {a.rel === 'prev' && <Icon name="arrow-left" size={13} />}
                  {a.label}
                  {a.rel === 'next' && <Icon name="arrow-right" size={13} />}
                </span>
                <span class="t" data-script={script(a.title)} data-vt-title={a.slug}>
                  <Typeset text={a.title} />
                </span>
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </article>
</Base>

<script>
  import '~/scripts/code';

  // Headings take a quiet anchor link for mouse users; keyboard and screen readers already have
  // the table of contents, so the anchor stays out of their way.
  document.querySelectorAll<HTMLElement>('[data-prose] :is(h2, h3)[id]').forEach((h) => {
    if (h.id === 'footnote-label') return;
    const a = Object.assign(document.createElement('a'), { href: `#${h.id}`, className: 'anchor', textContent: '#' });
    a.setAttribute('aria-hidden', 'true');
    a.tabIndex = -1;
    h.prepend(a);
  });

  // The table of contents follows the reading position: a heading becomes current as it enters the
  // top third of the window, and the previous one does again when it scrolls back below it.
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const links = new Map([...toc.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const heads = [...document.querySelectorAll<HTMLElement>('[data-prose] :is(h2, h3)[id]')].filter((h) => links.has(h.id));
    let current = -1;
    const mark = () => {
      links.forEach((a) => a.removeAttribute('aria-current'));
      const a = heads[current] ? links.get(heads[current]!.id) : undefined;
      toc.toggleAttribute('data-marked', !!a);
      if (!a) return;
      a.setAttribute('aria-current', 'location');
      toc.style.setProperty('--mark-y', `${a.offsetTop}px`);
      toc.style.setProperty('--mark-h', `${a.offsetHeight}px`);
    };
    // Resolve the actual reading position, including scrollbar jumps and history restoration.
    // A binary search needs only logarithmic geometry reads; scrolling writes styles only when
    // the current heading changes, with no timer or animation loop while the page is idle.
    let frame = 0;
    const update = () => {
      frame = 0;
      const edge = innerHeight * 0.34;
      let low = 0;
      let high = heads.length;
      while (low < high) {
        const middle = (low + high) >>> 1;
        if (heads[middle]!.getBoundingClientRect().top <= edge) low = middle + 1;
        else high = middle;
      }
      if (current !== low - 1) {
        current = low - 1;
        mark();
      }
    };
    const schedule = () => { frame ||= requestAnimationFrame(update); };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    addEventListener('pageshow', schedule);
    addEventListener('pagehide', () => { cancelAnimationFrame(frame); frame = 0; });
    const resize = new ResizeObserver(() => { mark(); schedule(); });
    resize.observe(toc);
    const prose = document.querySelector('[data-prose]');
    if (prose) resize.observe(prose);
    document.fonts.ready.then(schedule);
    schedule();
  }
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 42rem);
    justify-content: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1rem, 3vw, 2rem);
  }

  /* ---------- head ---------- */
  .head {
    padding-bottom: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
    border-bottom: var(--hairline) solid var(--line);
  }
  .back {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back:hover {
    color: var(--text);
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    font-size: var(--step--1);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .cat {
    color: var(--accent);
    text-decoration: none;
  }
  .cat:hover {
    color: var(--accent-strong);
  }
  .sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }
  h1 {
    margin-top: 1rem;
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.6rem);
    line-height: 1.12;
    font-variation-settings: 'opsz' 144;
    text-wrap: balance;
  }
  h1[data-script='latin'] {
    letter-spacing: var(--track-display);
    line-height: 1.06;
  }
  h1[data-script='han'] {
    line-height: 1.3;
  }
  .lede {
    margin-top: 1.25rem;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tags li {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--text) 6%, transparent);
    box-shadow: inset 0 0 0 var(--hairline) var(--line);
    color: var(--text-muted);
    font-size: var(--step--2);
    line-height: 1.5;
  }
  .updated {
    font-size: var(--step--1);
    color: var(--text-faint);
  }
  .other {
    margin-left: auto;
  }

  /* ---------- contents: a card above the text on narrow screens, a rail beside it on wide ones ---------- */
  .outline {
    margin-bottom: 2.5rem;
    border-radius: var(--r-card);
    corner-shape: var(--corner);
    background: var(--card-glass);
    box-shadow: var(--edge), var(--edge-lit), var(--elev-1);
  }
  .outline summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.15rem;
    cursor: pointer;
    list-style: none;
    color: var(--text-muted);
  }
  .outline summary::-webkit-details-marker {
    display: none;
  }
  .outline summary :global(.icon) {
    transition: rotate var(--spring-dur) var(--spring);
  }
  .outline[open] summary :global(.icon) {
    rotate: 180deg;
  }
  .outline nav {
    position: relative;
    padding: 0 1.15rem 1rem;
  }
  .outline ol {
    display: grid;
    gap: 0.1rem;
  }
  .outline a {
    display: block;
    padding: 0.3rem 0;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .outline a:hover,
  .outline a[aria-current] {
    color: var(--text);
  }
  .outline .subheading a {
    padding-left: 0.9rem;
    font-size: var(--step--2);
  }
  .toc-mark {
    display: none;
  }
  @media (min-width: 72rem) {
    .layout.has-outline {
      grid-template-columns: minmax(0, 42rem) 13.5rem;
      column-gap: clamp(3rem, 6vw, 5.5rem);
    }
    .head,
    .prose,
    .adjacent {
      grid-column: 1;
    }
    .outline {
      grid-column: 2;
      grid-row: 2 / span 2;
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + 2.5rem);
      margin: 0;
      background: none;
      box-shadow: none;
      border-radius: 0;
    }
    .outline summary {
      padding: 0 0 0.85rem;
    }
    .outline[open] summary :global(.icon) {
      display: none;
    }
    /* A hairline rail with a gilt mark that glides to the section being read. */
    .outline nav {
      padding: 0 0 0 1rem;
      box-shadow: inset var(--hairline) 0 0 var(--line-strong);
    }
    .toc-mark {
      display: block;
      position: absolute;
      left: 0;
      top: 0;
      width: 1.5px;
      height: var(--mark-h, 0);
      border-radius: 1px;
      background: var(--accent);
      opacity: 0;
      translate: 0 var(--mark-y, 0);
      transition:
        translate var(--spring-dur) var(--spring),
        height var(--spring-dur) var(--spring),
        opacity 0.3s;
    }
    [data-marked] > .toc-mark {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .toc-mark {
      transition: opacity 0.2s;
    }
  }

  /* ---------- the text ---------- */
  .prose {
    min-width: 0;
    font-size: clamp(1.0625rem, 1rem + 0.2vw, 1.125rem);
    line-height: 1.75;
    overflow-wrap: break-word;
  }
  .prose:lang(zh) {
    line-height: 1.88;
  }
  .prose :global(:is(p, ul, ol, blockquote, figure, table, .katex-display, img)) {
    margin-block: 0 1.15em;
  }
  /* GFM's visually hidden footnotes heading keeps its own rules. */
  .prose :global(:is(h2, h3, h4):not(.sr-only)) {
    position: relative;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .prose :global(h2:not(.sr-only)) {
    margin-block: 2.3em 0.7em;
    font-size: var(--step-2);
    line-height: 1.25;
  }
  .prose :global(h3) {
    margin-block: 1.9em 0.55em;
    font-size: var(--step-1);
    line-height: 1.35;
  }
  .prose :global(h4) {
    margin-block: 1.6em 0.45em;
    font-family: var(--font-sans);
    font-size: 1em;
    font-weight: 600;
  }
  /* Whatever opens the text sits right under the header's rule. */
  .prose > :global(:first-child:not(.sr-only)) {
    margin-top: 0;
  }
  .prose :global(.anchor) {
    position: absolute;
    right: 100%;
    padding-right: 0.45em;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-weight: 400;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .prose :global(:is(h2, h3):hover .anchor) {
    opacity: 1;
  }
  .prose :global(a:not(.anchor, [data-footnote-ref], [data-footnote-backref])) {
    color: var(--text);
    text-decoration-color: color-mix(in oklch, var(--accent) 65%, transparent);
    text-underline-offset: 0.24em;
  }
  .prose :global(a:not(.anchor):hover) {
    color: var(--accent);
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--text);
  }
  /* Emphasis on Chinese text: dots under the characters (integrations/article.mjs). */
  .prose :global(em.dots) {
    font-style: normal;
    text-emphasis: filled dot color-mix(in oklch, var(--accent) 85%, transparent);
    text-emphasis-position: under right;
  }
  .prose :global(:is(ul, ol)) {
    padding-left: 1.35em;
  }
  .prose :global(li) {
    margin-block: 0.3em;
    padding-left: 0.15em;
  }
  .prose :global(li::marker) {
    color: var(--text-faint);
  }
  .prose :global(ol > li::marker) {
    font-variant-numeric: tabular-nums;
  }
  .prose :global(blockquote) {
    margin-block: 1.75em;
    padding: 0.15em 0 0.15em 1.35em;
    border-left: 2px solid color-mix(in oklch, var(--accent) 70%, transparent);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--text);
  }
  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(hr) {
    width: 3rem;
    margin: 2.75em auto;
    border-top: var(--hairline) solid var(--line-strong);
  }
  .prose :global(:not(pre) > code) {
    padding: 0.12em 0.42em;
    border-radius: 0.4em;
    background: color-mix(in oklch, var(--text) 7%, transparent);
    box-shadow: inset 0 0 0 var(--hairline) var(--line);
    font-size: 0.86em;
    overflow-wrap: anywhere;
  }
  .prose :global(sup) {
    line-height: 0;
  }
  .prose :global([data-footnote-ref]) {
    padding-inline: 0.12em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }
  .prose :global(.footnotes) {
    margin-top: 3em;
    padding-top: 1.25em;
    border-top: var(--hairline) solid var(--line);
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--text-muted);
  }
  .prose :global([data-footnote-backref]) {
    color: var(--text-muted);
    text-decoration-color: color-mix(in oklch, currentColor 40%, transparent);
  }
  .prose :global(:is(h2, h3, h4, [id^='user-content-fn'])) {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .prose :global(img) {
    height: auto;
    max-width: 100%;
    border-radius: var(--r-card);
    corner-shape: var(--corner);
    box-shadow: var(--edge);
  }

  /* Code: a plate with a caption bar for the language and the copy button. */
  .prose :global(figure.code) {
    --code-bg: color-mix(in oklch, var(--bg-deep) 55%, var(--surface-solid));
    margin-block: 1.6em;
    border-radius: var(--r-card);
    corner-shape: var(--corner);
    background: var(--code-bg);
    box-shadow: var(--edge), var(--edge-lit);
    overflow: hidden;
  }
  /* On paper the plate is white: GitHub's light token colours are tuned for it (AA contrast). */
  :global(:root[data-theme='day']) .prose :global(figure.code) {
    --code-bg: oklch(1 0 0);
  }
  .prose :global(.code-bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.5rem;
    padding: 0.3rem 0.45rem 0.3rem 1.1rem;
    border-bottom: var(--hairline) solid var(--line);
  }
  .prose :global(.code-lang) {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }
  .prose :global(.code-copy) {
    display: inline-flex;
    align-items: center;
    height: 1.85rem;
    padding-inline: 0.75rem;
    border-radius: 999px;
    font-size: var(--step--2);
    color: var(--text-muted);
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .prose :global(.code-copy:hover) {
    color: var(--text);
    background: color-mix(in oklch, var(--text) 8%, transparent);
  }
  .prose :global(.code-copy[data-done]) {
    color: var(--ok);
  }
  .prose :global(.code-copy[hidden]) {
    display: none;
  }
  .prose :global(pre) {
    margin: 0;
    padding: 1rem 1.15rem 1.15rem;
    overflow-x: auto;
    font-size: 0.84rem;
    line-height: 1.7;
    tab-size: 2;
    max-width: 100%;
  }
  .prose :global(pre.astro-code) {
    background-color: transparent !important;
  }
  .prose :global(pre.astro-code span) {
    color: var(--shiki-light);
  }
  :global(:root[data-theme='night']) .prose :global(pre.astro-code span) {
    color: var(--shiki-dark);
  }

  /* Tables: rules between rows only, figures in tabular numerals, columns aligned as written. */
  .prose :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    margin-block: 1.6em;
    overflow-x: auto;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--step--1);
    line-height: 1.55;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .prose :global(:is(th, td)) {
    padding: 0.65rem 1.1rem;
    text-align: start;
    vertical-align: top;
    overflow-wrap: normal;
    border-bottom: var(--hairline) solid var(--line);
  }
  .prose :global(:is(th, td):first-child) {
    padding-left: 0;
  }
  .prose :global(:is(th, td):last-child) {
    padding-right: 0;
  }
  .prose :global(th) {
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    border-bottom-color: var(--line-strong);
  }
  .prose :global(:is(th, td)[align='right']) {
    text-align: right;
  }

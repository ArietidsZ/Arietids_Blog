---
import Icon from '~/components/ui/Icon.astro';
import Logo from '~/components/ui/Logo.astro';
import ThemeToggle from '~/components/ThemeToggle.astro';
import MotionToggle from '~/components/MotionToggle.astro';
import { localePath, t, unlocalizedPath, type Locale } from '~/i18n';
import { blogCategories, categoryLabel, categoryPath } from '~/lib/blog';
import { site } from '~/config/site';

interface Props { lang: Locale; alternates: readonly Locale[]; }
const { lang, alternates } = Astro.props;
const _ = t(lang);
const other = lang === 'zh' ? 'en' : 'zh';
const path = unlocalizedPath(Astro.url.pathname);
const switchHref = localePath(other, alternates.includes(other) ? path : '/');
const home = localePath(lang, '/');
const homepage = new URL(localePath(lang, '/'), site.homepage).href;
const links = blogCategories.map((category) => ({
  href: localePath(lang, categoryPath(category)),
  label: categoryLabel(category, lang),
  alternate: categoryLabel(category, other),
  current: path === categoryPath(category),
}));
const homeLabel = lang === 'zh' ? '个人主页' : 'Personal site';
---

<header class="site-header" data-header>
  <div class="bar container">
    <a class="brand" href={home} title={_('nav.home')}>
      <Logo size={26} />
      <span class="brand-name">{site.name}</span>
    </a>
    <nav class="nav" aria-label={_('nav.label')}>
      <ul role="list">
        {links.map((link) => <li><a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a></li>)}
        <li><a href={homepage} rel="external">{homeLabel} ↗</a></li>
      </ul>
    </nav>
    <div class="actions">
      <a class="lang" href={switchHref} hreflang={other === 'zh' ? 'zh-CN' : 'en'} lang={other === 'zh' ? 'zh-CN' : 'en'}>{_('lang.switch')}</a>
      <span class="motion-slot"><MotionToggle lang={lang} /></span>
      <ThemeToggle lang={lang} />
      <button class="menu-btn" popovertarget="site-menu" aria-label={_('nav.menu')}><Icon name="menu" size={20} /></button>
    </div>
  </div>
  <div id="site-menu" class="sheet" popover>
    <div class="sheet-head">
      <span class="mono faint">{_('nav.menu')}</span>
      <span class="sheet-motion"><MotionToggle lang={lang} /></span>
      <button popovertarget="site-menu" popovertargetaction="hide" aria-label={_('nav.close')}><Icon name="close" size={20} /></button>
    </div>
    <ul role="list">
      {links.map((link, i) => <li style={`--i:${i}`}><a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}<span class="alt" lang={other === 'zh' ? 'zh-CN' : 'en'} aria-hidden="true">{link.alternate}</span></a></li>)}
      <li style={`--i:${links.length}`}><a href={homepage} rel="external">{homeLabel}<span aria-hidden="true">↗</span></a></li>
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  // Close the mobile sheet after choosing a destination.
  const sheet = document.getElementById('site-menu');
  sheet?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => sheet.hidePopover?.()));
  // Tabbing out of the open sheet closes it, so focus never lands on the dimmed page behind.
  sheet?.addEventListener('focusout', (e) => {
    const next = (e as FocusEvent).relatedTarget as Node | null;
    if (next && !sheet.contains(next) && sheet.matches(':popover-open')) sheet.hidePopover?.();
  });

</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--ease-out);
  }
  /* Glass lives on a pseudo-element so it can fade in, and so the minifier never merges it away. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: color-mix(in oklch, var(--bg) 78%, transparent);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow:
      inset 0 1px 0 color-mix(in oklch, white 4%, transparent),
      0 14px 24px -18px oklch(0 0 0 / 0.5);
    transition: opacity 0.4s var(--ease-out);
  }
  :global(:root[data-theme='day']) .site-header::before {
    box-shadow:
      inset 0 1px 0 oklch(1 0 0 / 0.5),
      0 12px 24px -20px oklch(0.3 0.05 266 / 0.22);
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--line);
  }
  .site-header[data-scrolled]::before {
    opacity: 1;
  }
  /* Reading progress: a thin meteor crossing under the bar as the page scrolls. */
  .site-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    transform-origin: 0 50%;
    scale: 0 1;
    opacity: 0;
    background: linear-gradient(to right, transparent, color-mix(in oklch, var(--accent) 60%, transparent) 70%, var(--accent));
    transition: opacity 0.4s;
  }
  @supports (animation-timeline: scroll()) {
    /* Longhands only: folded into the shorthand by the minifier, the rule is dropped by Chrome. */
    .site-header::after {
      animation-name: read-progress;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
    }
    .site-header[data-scrolled]::after {
      opacity: 1;
    }
  }
  @keyframes read-progress {
    to {
      scale: 1 1;
    }
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text);
  }
  .brand:hover {
    color: var(--accent);
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    font-variation-settings: 'opsz' 30;
  }

  .nav {
    margin-inline: auto;
  }
  .nav ul {
    display: flex;
    gap: 0.25rem;
  }
  .nav a {
    position: relative;
    display: block;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav a[aria-current] {
    color: var(--text);
  }
  .nav a[aria-current]::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.05rem;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--glow);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }
  .nav + .actions {
    margin-left: 0;
  }
  .lang {
    font-size: var(--step--1);
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    color: var(--text-muted);
    text-decoration: none;
    border: 1px solid var(--line);
  }
  .lang:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }

  .menu-btn {
    display: none;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    color: var(--text);
  }
  .menu-btn:hover {
    background: var(--surface-2);
  }

  .sheet {
    inset: 0 0 auto auto;
    margin: 0.5rem;
    width: min(24rem, calc(100vw - 1rem));
    padding: 1rem 1.25rem 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-l);
    background: var(--surface-solid);
    color: var(--text);
    box-shadow: var(--shadow);
    opacity: 0;
    translate: 0 -0.75rem;
    transition:
      opacity 0.25s var(--ease-out),
      translate 0.25s var(--ease-out),
      display 0.25s allow-discrete,
      overlay 0.25s allow-discrete;
  }
  .sheet:popover-open {
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .sheet:popover-open {
      opacity: 0;
      translate: 0 -0.75rem;
    }
  }
  .sheet::backdrop {
    background: oklch(0 0 0 / 0.35);
    backdrop-filter: blur(3px);
  }
  .sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .sheet-head button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
  }
  .sheet a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.2rem + 0.75vw, 1.6rem);
    word-break: keep-all;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .sheet .alt {
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .sheet .alt:lang(zh) {
    font-family: var(--font-cjk-display);
    letter-spacing: 0.3em;
  }
  .sheet li {
    opacity: 0;
    translate: 0.75rem 0;
    transition:
      opacity 0.35s var(--ease-out),
      translate 0.45s var(--ease-out);
    transition-delay: calc(0.05s + var(--i) * 0.05s);
  }
  .sheet:popover-open li {
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .sheet:popover-open li {
      opacity: 0;
      translate: 0.75rem 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet li,
    .sheet:popover-open li {
      translate: none;
    }
  }

  @media (max-width: 54rem) {
    .nav a {
      padding-inline: 0.55rem;
    }
  }
  .sheet-motion {
    margin-left: auto;
    margin-right: 0.25rem;
  }
  @media (max-width: 46rem) {
    .nav {
      display: none;
    }
    /* On phones the pause switch lives in the menu sheet. */
    .motion-slot {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
    .actions {
      margin-left: auto !important;
    }
  }
</style>
